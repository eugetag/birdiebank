# Golf Bet Ledger environment variables
#
# Copy this file to `.env.local` and fill in your values. The app keeps
# working with the in-browser localStorage backend when these are absent;
# providing them flips the storage backend to Supabase (no UI changes yet).

# Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose in the client bundle — RLS policies on
# the database enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
